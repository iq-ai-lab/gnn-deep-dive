.dgl_cache/

# HuggingFace / datasets cache
.cache/huggingface/
datasets_cache/

# ── Graph / dataset caches ───────────────────────────────────────────────────
# PyG 표준 데이터셋 디렉토리 (Planetoid, TUDataset, OGB 등)
# 각 챕터의 실험에서 다운로드되는 raw / processed
# Ch1-04 Karate club·spectral clustering,
# Ch2-03 Cora·Citeseer GCN 재현,
# Ch3-02 Reddit·PPI large-scale GraphSAGE,
# Ch3-04 MUTAG·PROTEINS TUDataset,
# Ch4-04 CSL·Paley strongly regular graphs,
# Ch5-01 Cora·Citeseer over-smoothing 측정,
# Ch6 OGB node/link/graph benchmarks,
# Ch7-01 OGB-LSC PCQM4M, Ch7-03 QM9·MD17
data/
datasets/
Planetoid/
TUDataset/
ogb_data/
ogbn_*/
ogbg_*/
ogbl_*/
qm9/
MD17/
ZINC/
MUTAG/
PROTEINS/
ENZYMES/
PPI/
Reddit/
raw/
processed/
!data/.gitkeep

# Downloaded raw graph files
*.edgelist
*.adjlist
*.gml
*.graphml
*.mat

# ── Experiment outputs ───────────────────────────────────────────────────────
# 생성된 이미지·시각화 결과물 (각 챕터)
# Ch1: Fiedler vector 클러스터링·graph Fourier 기저·PageRank heatmap,
# Ch2: ChebNet K-hop 시각화·GCN propagation matrix,
# Ch3: GAT attention weight·GIN vs Mean WL-fail·GraphSAGE sampling,
# Ch4: 1-WL refinement step·CSL non-isomorphic 쌍·LapPE 시각화,
# Ch5: over-smoothing cosine similarity plot·$P^L$ 고유값 감쇠,
# Ch6: node embedding t-SNE·link prediction ROC·graph generation sample,
# Ch7: Graphormer attention map·EGNN 분자 궤적·scaling 곡선
*.png
*.jpg
*.jpeg
*.svg
*.pdf
*.gif
*.mp4
*.webp

